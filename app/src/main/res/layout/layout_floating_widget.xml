<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView
        android:id="@+id/cardInputPanel"
        android:layout_width="290dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|start"
        android:visibility="gone"
        app:cardBackgroundColor="#212121"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:contentPadding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <EditText
                android:id="@+id/etOverlayIntent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:hint="Type or speak (e.g. Open QCam)"
                android:textColor="#FFFFFF"
                android:textColorHint="#9E9E9E"
                android:textSize="14sp"
                android:maxLines="2" />

            <TextView
                android:id="@+id/tvVoiceStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#80D8FF"
                android:textSize="12sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical|end"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/btnOverlayClose"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Cancel"
                    android:textColor="#B0BEC5" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOverlayMic"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:icon="@android:drawable/ic_btn_speak_now"
                    app:iconTint="#00E676" />

                <Button
                    android:id="@+id/btnOverlaySend"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Run" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabBubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        app:fabSize="mini"
        app:backgroundTint="#6200EE"
        app:tint="#FFFFFF"
        android:contentDescription="Trigger Assistant"
        app:srcCompat="@android:drawable/ic_btn_speak_now" />
</FrameLayout>
